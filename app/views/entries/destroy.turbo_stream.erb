<%= render_flash_stream %>
<%= turbo_stream.remove @entry %>

<% if current_user.entries.any? %>
  <%= turbo_stream.update "main-dashboard" do %>
    <%= render(partial: "entries/main", locals: {entry: current_user.entries.first}) %>
  <% end %>
<% else %>
  <%= turbo_stream.update "main-dashboard" do %>
    <%= render(html: content_tag(:h1, "No Entries", class: "d-flex align-items-center justify-content-center h-100") ) %>
  <% end %>
<% end %>